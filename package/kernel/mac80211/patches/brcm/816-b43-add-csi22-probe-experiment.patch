+#include <linux/etherdevice.h>
+#include <linux/moduleparam.h>
+
+static int b43_modparam_csi_rx_probe;
+module_param_named(csi_rx_probe, b43_modparam_csi_rx_probe, int, 0644);
+MODULE_PARM_DESC(csi_rx_probe, "Enable RX telemetry probe: 0=off, 1=on");
+
+static char b43_modparam_csi_rx_srcmac[20];
+module_param_string(csi_rx_srcmac, b43_modparam_csi_rx_srcmac,
+                    sizeof(b43_modparam_csi_rx_srcmac), 0644);
+MODULE_PARM_DESC(csi_rx_srcmac, "Optional source-MAC filter (aa:bb:cc:dd:ee:ff)");
+
+static s16 b43_csi_rx_decode_foff(u16 phystat2)
+{
+	u16 raw = phystat2 & B43_RX_PHYST2_FOFF;
+	if (raw & 0x0200)
+		return (s16)(raw | 0xFC00);
+	return (s16)raw;
+}
+
+static void b43_csi_rx_sample(struct b43_wldev *dev, const u8 *src,
+			      s16 signal, u8 noise, s16 foff, u16 chanid,
+			      u16 phystat4, u16 phystat5, bool have_phystat45)
+{
+	u8 filter_addr[ETH_ALEN];
+
+	if (b43_modparam_csi_rx_srcmac[0]) {
+		if (mac_pton(b43_modparam_csi_rx_srcmac, filter_addr)) {
+			if (!ether_addr_equal(src, filter_addr))
+				return;
+		}
+	}
+
+	b43info(dev->wl,
+		"CSI-RX pkt: src=%pM sig=%d noise=%u foff=%d chan=%u phy4=%04x phy5=%04x\n",
+		src, signal, noise, foff, chanid,
+		have_phystat45 ? phystat4 : 0, have_phystat45 ? phystat5 : 0);
+}
